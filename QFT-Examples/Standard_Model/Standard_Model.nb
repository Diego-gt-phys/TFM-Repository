         SubscriptBox[
          OverscriptBox["b", "_"], "R"]}]}], ")"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Yuk", "=", 
