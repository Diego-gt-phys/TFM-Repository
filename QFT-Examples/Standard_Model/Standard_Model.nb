     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SubscriptBox["y", "t"], " ", 
         RowBox[{"PhiwigHC", ".", "QL"}], " ", 
         SubscriptBox[
          OverscriptBox["t", "_"], "R"]}], "+", 
        RowBox[{
         SubscriptBox["y", "b"], " ", 
