b6327344cc7c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Group", " ", "Theory", " ", "Matrices"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sigpauli1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eins", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugefields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["W", "1"], ",", 
       SubscriptBox["W", "2"], ",", 
       SubscriptBox["W", "3"], ",", "B"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cw", "=", 
     RowBox[{"g", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sw", "=", 
     RowBox[{
      SubscriptBox["g", "w"], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Rot", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cw", ",", 
         RowBox[{"-", "sw"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sw", ",", "cw"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Quark", " ", "weyl", " ", "spinors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QLbar", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"QL", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["b", "L"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barfermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["t", "_"], "R"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "R"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["t", "R"], ",", 
       SubscriptBox["b", "L"], ",", 
       SubscriptBox["b", "R"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "t"], "]"}], "^=", 
     SubscriptBox["y", "t"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "b"], "]"}], "^=", 
     SubscriptBox["y", "b"]}], ";"}], "\n", 
   RowBox[{"(*", "Scalars", "*)"}], "\n", 
   RowBox[{
    RowBox[{"Phi", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["\[Chi]", "1"], "+", 
           RowBox[{"\[ImaginaryI]", "*", 
            SubscriptBox["\[Chi]", "2"]}]}], ")"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"\[CurlyPhi]", "+", "h", "+", 
           RowBox[{"\[ImaginaryI]", "*", 
            SubscriptBox["\[Chi]", "3"]}]}], ")"}]}], "}"}]}], "}"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"PhiHC", "=", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"Transpose", "[", "Phi", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phiwig", "=", 
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"sigpauli2", ".", 
        RowBox[{"Conjugate", "[", "Phi", "]"}]}]}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PhiwigHC", "=", 
     RowBox[{"ConjugateTranspose", "[", "Phiwig", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Chi]", "1"], ",", 
       SubscriptBox["\[Chi]", "2"], ",", 
       SubscriptBox["\[Chi]", "3"], ",", "h"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["\[Chi]", "1"], "]"}], "^=", 
     SubscriptBox["\[Chi]", "1"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["\[Chi]", "2"], "]"}], "^=", 
     SubscriptBox["\[Chi]", "2"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["\[Chi]", "3"], "]"}], "^=", 
     SubscriptBox["\[Chi]", "3"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "h", "]"}], "^=", "h"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "\[CurlyPhi]", "]"}], "^=", "\[CurlyPhi]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UG", " ", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Chi]", "1"], "->", "0"}], ",", 
       RowBox[{
        SubscriptBox["\[Chi]", "2"], "->", "0"}], ",", 
       RowBox[{
        SubscriptBox["\[Chi]", "3"], "->", "0"}], ",", 
       RowBox[{"h", "->", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VEV", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\[CurlyPhi]", "->", "v"}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9957780573279133`*^9, 3.995778160002935*^9}, {
  3.995778457721389*^9, 3.995778482260697*^9}, {3.99577960973701*^9, 
  3.995779702636541*^9}, {3.995780065880073*^9, 3.995780070264009*^9}, {
