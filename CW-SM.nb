      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["t", "R"], ",", 
       SubscriptBox["b", "L"], ",", 
       SubscriptBox["b", "R"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "t"], "]"}], "^=", 
     SubscriptBox["y", "t"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "b"], "]"}], "^=", 
