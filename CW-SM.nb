Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"SU", 
    RowBox[{"(", "2", ")"}], " ", "Doublet"}], "*)"}], "\[IndentingNewLine]", 
  
  RowBox[{
   RowBox[{
    RowBox[{"Phi", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["G", "+"], "+", 
           RowBox[{"\[ImaginaryI]", "*", 
            SuperscriptBox["G", "-"]}]}], ")"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"h", "+", 
           RowBox[{"\[ImaginaryI]", "*", "\[Chi]"}]}], ")"}]}], "}"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhiHC", "=", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"Transpose", "[", "Phi", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phiwig", "=", 
     RowBox[{"(", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"sigpauli2", ".", 
        RowBox[{"Conjugate", "[", "Phi", "]"}]}]}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PhiwigHC", "=", 
     RowBox[{"ConjugateTranspose", "[", "Phiwig", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Real", " ", "Scalar", " ", "Components"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["G", "+"], ",", 
       SuperscriptBox["G", "-"], ",", "\[Chi]", ",", "h"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "+"], "]"}], "^=", 
     SuperscriptBox["G", "+"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "-"], "]"}], "^=", 
     SuperscriptBox["G", "-"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "\[Chi]", "]"}], "^=", "\[Chi]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "h", "]"}], "^=", "h"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Unitary", " ", "Condition"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"UnitG", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["G", "+"], "->", "0"}], ",", 
       RowBox[{
        SuperscriptBox["G", "-"], "->", "0"}], ",", 
       RowBox[{"\[Chi]", "->", "0"}], ",", 
       RowBox[{"h", "->", "v"}]}], "}"}]}], ";"}]}]}]], "Input",
