Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Hessian", " ", "Mass", " ", "Matrix"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"MassMatrixScalars", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"D", "[", 
