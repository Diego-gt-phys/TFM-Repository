Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"V", "[", 
    RowBox[{"h_", ",", "s_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"1", "/", "2"}], "*", 
