     SubscriptBox["\[Mu]", "m"], "*", "s", "*", 
     RowBox[{"h", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"1", "/", "4"}], "*", 
     SubscriptBox["\[Lambda]", "m"], "*", 
     RowBox[{"s", "^", "2"}], "*", 
     RowBox[{"h", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Mu]", "1"], "^", "3"}], "*", "s"}], "+", 
    RowBox[{
     RowBox[{"1", "/", "3"}], "*", 
     SubscriptBox["\[Mu]", "3"], "*", 
     RowBox[{"s", "^", "3"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"V", "[", 
