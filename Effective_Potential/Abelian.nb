Cell[CellGroupData[{

Cell["Define the Tree Level Potential", "Subsection",
 CellChangeTimes->{{3.988446472221287*^9, 
  3.9884464841172028`*^9}},ExpressionUUID->"90e9cd40-f127-9246-af55-\
31d924793352"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Vtree", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"\[Mu]", "^", "2"}]}], " ", 
      RowBox[{"PhiHC", ".", "Phi"}]}], "+", 
     RowBox[{"\[Lambda]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"PhiHC", ".", "Phi"}], ")"}], "^", "2"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Vtree", "/.", "VEV"}], "/.", 
  RowBox[{"{", 
   RowBox[{"v", "->", "\[CurlyPhi]"}], "}"}]}]}], "Input",
 CellChangeTimes->{{3.988446074659054*^9, 3.9884461411573124`*^9}, {
  3.988446184328808*^9, 3.988446190224497*^9}, {3.9884462643282223`*^9, 
  3.988446308343441*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"a5c4eb22-2810-0240-aa30-d5788051a5bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "2"]}], " ", 
   SuperscriptBox["\[Mu]", "2"], " ", 
   SuperscriptBox["\[CurlyPhi]", "2"]}], "+", 
  FractionBox[
   RowBox[{"\[Lambda]", " ", 
    SuperscriptBox["\[CurlyPhi]", "4"]}], "4"]}]], "Output",
 CellChangeTimes->{{3.988446142825075*^9, 3.9884462031804867`*^9}, {
  3.988446264666397*^9, 3.9884463092843876`*^9}},
 CellLabel->
  "Out[104]=",ExpressionUUID->"67c59c55-a8c9-1c4f-a450-7b648395a5db"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

