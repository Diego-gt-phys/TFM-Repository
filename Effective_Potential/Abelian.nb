389b0ce95568"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"\[ImaginaryI]", " ", "g", " ", "A", "*", 
    RowBox[{"Phi", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LGauge", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"ComplexExpand", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", "P", "]"}], "*", "P"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LGauge", "/.", "VEV"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Mass", " ", "Matrix", " ", "in", " ", "Interaction", " ", "Basis"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MassGaugeMatrix", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"i", "==", "j"}], ",", 
        RowBox[{"2", " ", 
         RowBox[{"Simplify", "[", 
          RowBox[{"Coefficient", "[", 
           RowBox[{"LGauge", ",", 
            RowBox[{"gaugefields", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", "2"}], "]"}], "]"}]}], ",", 
        RowBox[{"Simplify", "[", 
         RowBox[{"Coefficient", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{"LGauge", ",", 
             RowBox[{"gaugefields", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"gaugefields", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MassGaugeMatrix", "/.", "VEV"}], "//", "MatrixForm"}]}], "Input",
