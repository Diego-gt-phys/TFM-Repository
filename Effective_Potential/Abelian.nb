Cell[CellGroupData[{
Cell["Effective Potential:\[LineSeparator]Abelian Higgs Model", "Title",
 CellChangeTimes->{{3.988443908171301*^9, 
  3.988443955559744*^9}},ExpressionUUID->"1d00627c-6178-5c49-aadf-\
b67c517df8f7"],

Cell[CellGroupData[{

Cell["Define the Fields", "Section",
 CellChangeTimes->{{3.9884456132075577`*^9, 
  3.9884456210464287`*^9}},ExpressionUUID->"ac7bf43e-298f-9848-af93-\
1a59c48adf4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sigpauli1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eins", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugefields", "=", 
     RowBox[{"{", "A", "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "A", "]"}], "^=", "A"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "g", "]"}], "^=", "g"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Scalars", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sfields", "=", 
     RowBox[{"{", 
      RowBox[{"\[Chi]", ",", "\[Phi]"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
       RowBox[{"(", 
        RowBox[{"v", "+", "\[Phi]", "+", 
         RowBox[{"\[ImaginaryI]", "*", "\[Chi]"}]}], ")"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhiHC", "=", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"Transpose", "[", "Phi", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "v", "]"}], "^=", "v"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "\[Phi]", "]"}], "^=", "\[Phi]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "\[Chi]", "]"}], "^=", "\[Chi]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VEV", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Phi]", "->", "0"}], ",", 
       RowBox[{"\[Chi]", "->", "0"}]}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988445641431326*^9, 3.9884456421513577`*^9}, {
  3.9884457016537304`*^9, 3.9884458844160805`*^9}, {3.9884461494612026`*^9, 
