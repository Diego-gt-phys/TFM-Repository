      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "sfields", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "sfields", "]"}]}], "}"}]}], 
