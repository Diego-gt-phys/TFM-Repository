Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"Vtree", ",", "\[Phi]"}], "]"}], "==", "0"}], "/.", "VEV"}], 
   ",", "\[Mu]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9884465580130672`*^9, 3.9884465630410423`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"55a9b9b6-3310-0849-9247-911c6d6d7281"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[Mu]", "\[Rule]", 
     RowBox[{
      RowBox[{"-", "v"}], " ", 
      SqrtBox["\[Lambda]"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Mu]", "\[Rule]", 
     RowBox[{"v", " ", 
      SqrtBox["\[Lambda]"]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.988446564092451*^9},
