Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Yukawa", " ", "Lagrangian"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Yuk1", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["y", "t"], " ", 
           RowBox[{"QLbar", ".", "Phiwig"}], " ", 
           SubscriptBox["t", "R"]}], "+", 
          RowBox[{
           SubscriptBox["y", "b"], " ", 
           RowBox[{"QLbar", ".", "Phi"}], " ", 
           SubscriptBox["b", "R"]}]}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Yuk2", "=", 
     RowBox[{"Expand", "[", 
      RowBox[{"-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SubscriptBox["y", "t"], " ", 
           RowBox[{"PhiwigHC", ".", "QL"}], " ", 
           SubscriptBox[
            OverscriptBox["t", "_"], "R"]}], "+", 
          RowBox[{
           SubscriptBox["y", "b"], " ", 
           RowBox[{"PhiHC", ".", "QL"}], " ", 
           SubscriptBox[
            OverscriptBox["b", "_"], "R"]}]}], ")"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Yuk", "=", 
     RowBox[{"Yuk1", "+", "Yuk2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Yuk", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SuperscriptBox["G", "+"], "->", "0"}], ",", 
      RowBox[{
       SuperscriptBox["G", "-"], "->", "0"}], ",", 
      RowBox[{"\[Chi]", "->", "0"}], ",", 
      RowBox[{"h", "->", "v"}]}], "}"}]}]}]}]], "Input",
