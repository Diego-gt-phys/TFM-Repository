Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox[
    RowBox[{"v", " ", 
     SubscriptBox["b", "R"], " ", 
     SubscriptBox["y", "b"], " ", 
     SubscriptBox[
      OverscriptBox["b", "_"], "L"]}], 
    SqrtBox["2"]]}], "-", 
  FractionBox[
   RowBox[{"v", " ", 
    SubscriptBox["b", "L"], " ", 
