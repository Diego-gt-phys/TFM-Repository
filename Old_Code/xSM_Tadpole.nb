        " ", "\n", "     ", 
       RowBox[{
        RowBox[{"1", "/", "2"}], "*", 
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"\[Mu]", ",", " ", "S"}], "]"}], "^", "2"}], "*", 
        RowBox[{"Si", "^", "2"}]}], " ", "+", " ", "\n", "     ", 
       RowBox[{
        RowBox[{"1", "/", "4"}], "*", 
        RowBox[{"Subscript", "[", 
