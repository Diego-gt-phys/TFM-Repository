Cell[BoxData[
 RowBox[{
  RowBox[{"T2", "[", 
   RowBox[{"ms_", ",", "lHS_", ",", "lS_"}], "]"}], ":=", 
  RowBox[{
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      SqrtBox["lS"], " ", 
      SubsuperscriptBox["m", "H", "2"]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["ms", "2"]}], "+", 
        FractionBox[
         RowBox[{"lHS", " ", 
          SuperscriptBox["v", "2"]}], "2"]}], ")"}], " ", 
      SqrtBox[
       SubscriptBox["\[Lambda]", "H"]]}]}], 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["lHS", "6"], "+", 
        FractionBox["lS", "4"]}], ")"}], " ", 
      SqrtBox[
       SubscriptBox["\[Lambda]", "H"]]}], "-", 
     RowBox[{
      FractionBox["1", "48"], " ", 
      SqrtBox["lS"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"9", " ", 
         SuperscriptBox["g", "2"]}], "+", 
        RowBox[{"2", " ", "lHS"}], "+", 
        RowBox[{"3", " ", 
         SubsuperscriptBox["g", "w", "2"]}], "+", 
        RowBox[{"12", " ", 
         SubsuperscriptBox["y", "b", "2"]}], "+", 
        RowBox[{"12", " ", 
         SubsuperscriptBox["y", "t", "2"]}], "+", 
        RowBox[{"24", " ", 
         SubscriptBox["\[Lambda]", "H"]}]}], ")"}]}]}]], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["m", "H"], "->", "125.2"}], ",", 
     RowBox[{"v", "->", "246.22"}], ",", 
