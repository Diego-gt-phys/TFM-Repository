      SubscriptBox["\[CurlyPhi]", "S"], " ", "+", " ", "s"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PhiHC", "=", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"Transpose", "[", "Phi", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phiwig", "=", 
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"sigpauli2", ".", 
        RowBox[{"Conjugate", "[", "Phi", "]"}]}]}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PhiwigHC", "=", 
     RowBox[{"ConjugateTranspose", "[", "Phiwig", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["G", "+"], ",", 
       SuperscriptBox["G", "-"], ",", "\[Chi]", ",", "h", ",", "s"}], "}"}]}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "+"], "]"}], "^=", 
     SuperscriptBox["G", "+"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "-"], "]"}], "^=", 
