Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sigpauli1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eins", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugefields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["W", "1"], ",", 
       SubscriptBox["W", "2"], ",", 
       SubscriptBox["W", "3"], ",", "B"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cw", "=", 
     RowBox[{"g", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sw", "=", 
     RowBox[{
      SubscriptBox["g", "w"], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Rot", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cw", ",", 
         RowBox[{"-", "sw"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sw", ",", "cw"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Quark", " ", "weyl", " ", "spinors"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QLbar", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"QL", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["b", "L"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barfermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["t", "_"], "R"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "R"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["t", "R"], ",", 
       SubscriptBox["b", "L"], ",", 
       SubscriptBox["b", "R"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "t"], "]"}], "^=", 
