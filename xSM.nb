      RowBox[{
       SubscriptBox["\[Lambda]", "H"], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"PhiHC", ".", "Phi"}], ")"}], "^", "2"}]}], "-", 
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       RowBox[{
        SubscriptBox["\[Mu]", "S"], "^", "2"}], "*", 
       RowBox[{"Si", "^", "2"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "4"}], "*", 
       SubscriptBox["\[Lambda]", "S"], "*", 
       RowBox[{"Si", "^", "4"}]}], "+", 
      RowBox[{
       RowBox[{"1", "/", "2"}], "*", 
       SubscriptBox["\[Lambda]", "HS"], "*", 
       RowBox[{"PhiHC", ".", "Phi"}], "*", 
       RowBox[{"Si", "^", "2"}]}], "+", 
      RowBox[{
       SubscriptBox["\[Mu]", "HS"], 
       RowBox[{"PhiHC", ".", "Phi"}], "*", "Si"}], "-", 
      RowBox[{
       RowBox[{"1", "/", "3"}], "*", 
       SubscriptBox["\[Mu]", "3"], "*", 
       RowBox[{"Si", "^", "3"}]}]}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
