       RowBox[{"PhiHC", ".", "Phi"}], "*", 
       RowBox[{"Si", "^", "2"}]}], "+", 
      RowBox[{
       SubscriptBox["\[Mu]", "HS"], 
       RowBox[{"PhiHC", ".", "Phi"}], "*", "Si"}], "-", 
      RowBox[{
