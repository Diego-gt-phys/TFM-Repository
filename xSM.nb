     RowBox[{"Conjugate", "[", "v", "]"}], "^=", "v"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "s", "]"}], "^=", "s"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VEV", " ", "=", " ", 
     RowBox[{"{", 
