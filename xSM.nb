       RowBox[{"Si", "^", "2"}]}], "+", 
      RowBox[{
       SubscriptBox["\[Mu]", "HS"], 
       RowBox[{"PhiHC", ".", "Phi"}], "*", "Si"}], "-", 
      RowBox[{
       RowBox[{"1", "/", "3"}], "*", 
