Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"sigpauli1", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "\[ImaginaryI]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[ImaginaryI]", ",", "0"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigpauli3", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eins", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Gauge", " ", "Fields"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gaugefields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["W", "1"], ",", 
       SubscriptBox["W", "2"], ",", 
       SubscriptBox["W", "3"], ",", "B"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cw", "=", 
     RowBox[{"g", "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sw", "=", 
     RowBox[{
      SubscriptBox["g", "w"], "/", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"g", "^", "2"}], "+", 
        RowBox[{
         SubscriptBox["g", "w"], "^", "2"}]}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Rot", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"cw", ",", 
         RowBox[{"-", "sw"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"sw", ",", "cw"}], "}"}]}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Quark", " ", "weyl", " ", "spinors"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"QLbar", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"QL", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["b", "L"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"barfermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox[
        OverscriptBox["t", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["t", "_"], "R"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "L"], ",", 
       SubscriptBox[
        OverscriptBox["b", "_"], "R"]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"fermfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["t", "L"], ",", 
       SubscriptBox["t", "R"], ",", 
       SubscriptBox["b", "L"], ",", 
       SubscriptBox["b", "R"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "t"], "]"}], "^=", 
     SubscriptBox["y", "t"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SubscriptBox["y", "b"], "]"}], "^=", 
     SubscriptBox["y", "b"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Scalars", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phi", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["G", "+"], "+", 
           RowBox[{"\[ImaginaryI]", "*", 
            SuperscriptBox["G", "-"]}]}], ")"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{"v", "+", "h", "+", 
           RowBox[{"\[ImaginaryI]", "*", "\[Chi]"}]}], ")"}]}], "}"}]}], 
      "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Si", " ", "=", " ", 
     RowBox[{"u", "+", "s"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"PhiHC", "=", 
     RowBox[{"Conjugate", "[", 
      RowBox[{"Transpose", "[", "Phi", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Phiwig", "=", 
     RowBox[{"(", 
      RowBox[{"I", " ", 
       RowBox[{"sigpauli2", ".", 
        RowBox[{"Conjugate", "[", "Phi", "]"}]}]}], ")"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"PhiwigHC", "=", 
     RowBox[{"ConjugateTranspose", "[", "Phiwig", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sfields", "=", 
     RowBox[{"{", 
      RowBox[{
       SuperscriptBox["G", "+"], ",", 
       SuperscriptBox["G", "-"], ",", "\[Chi]", ",", "h", ",", "s"}], "}"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "+"], "]"}], "^=", 
     SuperscriptBox["G", "+"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", 
      SuperscriptBox["G", "-"], "]"}], "^=", 
     SuperscriptBox["G", "-"]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "\[Chi]", "]"}], "^=", "\[Chi]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "h", "]"}], "^=", "h"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "v", "]"}], "^=", "v"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Conjugate", "[", "s", "]"}], "^=", "s"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"VEV", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SuperscriptBox["G", "+"], "->", "0"}], ",", 
       RowBox[{
        SuperscriptBox["G", "-"], "->", "0"}], ",", 
       RowBox[{"\[Chi]", "->", "0"}], ",", 
       RowBox[{"h", "->", "0"}], ",", 
       RowBox[{"s", "->", "0"}]}], "}"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9867096599718704`*^9, 3.986709737333084*^9}, {
