       RowBox[{
        SuperscriptBox["s", "4"], " ", 
        SubscriptBox["\[Lambda]", "S"]}], "4"], "-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["s", "3"], " ", 
        SubscriptBox["\[Mu]", "3"]}], "3"], "-", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SuperscriptBox["h", "2"], " ", 
       SubsuperscriptBox["\[Mu]", "H", "2"]}], "+", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SuperscriptBox["h", "2"], " ", "s", " ", 
       SubscriptBox["\[Mu]", "HS"]}], "-", 
      RowBox[{
       FractionBox["1", "2"], " ", 
       SuperscriptBox["s", "2"], " ", 
       SubsuperscriptBox["\[Mu]", "S", "2"]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Params0", " ", "=", 
