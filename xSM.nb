Cell[BoxData[{
 RowBox[{
  RowBox[{"Vtree", "=", 
   RowBox[{
    RowBox[{"Expand", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{
         SubscriptBox["\[Mu]", "H"], "^", "2"}]}], " ", 
